                <mxCell id="49" value="&lt;div&gt;RenderProcess&lt;/div&gt;&lt;div&gt;（Renderer 侧：与上面 Host 一一对应的本体）&lt;/div&gt;&lt;div&gt;❓它对应 Electron 的什么？—— 不是 ipcRenderer，自己填&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=32;" vertex="1" parent="1">
                    <mxGeometry x="1220" y="710" width="440" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="50" value="&lt;b&gt;&lt;font color=&quot;#000000&quot;&gt;ipcMain / ipcRenderer&lt;/font&gt;&lt;/b&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;= Browser 与 Renderer 之间的 Mojo 消息管道&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;（Remote 发 / Receiver 收，BrowserInterfaceBroker 牵线）&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;⚠️ 别和左右两个 RenderProcess* 框混为一谈：&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;那两个是「进程的代表对象」，这个是「通话的那条线」&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font color=&quot;#000000&quot;&gt;（教练只查证到「是 Mojo 管道」这一层，具体 mojom 接口未核实）&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=28;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
                    <mxGeometry x="886.25" y="1250" width="700" height="260" as="geometry"/>
